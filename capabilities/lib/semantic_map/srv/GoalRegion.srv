# robonix/system/scene/goal_region - find a navigation-safe pose inside
# a user-defined region annotation, or at a POI. The returned map-frame
# pose is always inside the region polygon, or is the POI's own pose;
# pass it to navigation/navigate.

string region_id
---
bool reachable
float64 x
float64 y
float64 yaw
# Same pose as (x, y, yaw), ready for navigation/navigate's `goal`.
# Valid only when reachable is true; otherwise left empty.
geometry_msgs/PoseStamped goal
string reason
